# 카카오 책 검색 API — REST API 키 (developers.kakao.com > 내 애플리케이션 > 앱 키 > REST API 키)
KAKAO_REST_API_KEY=여기에_카카오_REST_API_키

# (선택) 국립중앙도서관 ISBN 서지정보 인증키 — 카카오가 못 찾는 책 보완용. 없으면 비워두세요.
NL_CERT_KEY=

# PostgreSQL 연결 문자열 (예: Neon 의 Pooled connection 문자열)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
